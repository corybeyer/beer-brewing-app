{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "StepV1": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Title"
        },
        "instructions": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Instructions"
        },
        "dependencies": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Dependencies",
          "type": "array"
        },
        "anchor_step_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Anchor Step Id"
        }
      },
      "required": [
        "id",
        "title",
        "instructions",
        "dependencies",
        "anchor_step_id"
      ],
      "title": "StepV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "expected_revision": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Expected Revision",
      "type": "integer"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/StepV1"
      },
      "maxItems": 100,
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "expected_revision",
    "steps"
  ],
  "title": "UpdateStepsV1",
  "type": "object"
}
